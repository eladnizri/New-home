rules_version = '2';

// Access model: the home id in the share link IS the credential, the same way
// an unlisted document link works. Ids are 24 random characters, so they are not
// guessable. Anyone signed in (anonymous auth included) who holds a valid id may
// read and write that home — and nothing else.
//
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function validId(id) {
      return id is string && id.size() >= 20 && id.size() <= 64
             && id.matches('^[A-Za-z0-9]+$');
    }

    function signedIn() {
      return request.auth != null;
    }

    match /homes/{homeId} {
      allow read, write: if signedIn() && validId(homeId);

      match /items/{itemId} {
        allow read, write: if signedIn() && validId(homeId);
      }
    }

    // Everything outside /homes stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
